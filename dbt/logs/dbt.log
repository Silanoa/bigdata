        WHEN 10 THEN 'octobre'
        WHEN 11 THEN 'novembre'
        WHEN 12 THEN 'decembre'
        END AS mois,
    CASE EXTRACT(DOW FROM date_vente)
        WHEN 0 THEN 'dimanche'
        WHEN 1 THEN 'lundi'
        WHEN 2 THEN 'mardi'
        WHEN 3 THEN 'mercredi'
        WHEN 4 THEN 'jeudi'
        WHEN 5 THEN 'vendredi'
        WHEN 6 THEN 'samedi'
        END AS jour,
    prix_unitaire AS pu,
    quantite AS qte,
    facture_id,
    livre_id,
    created_at
FROM source
        );
