create or replace transient table BOOKSHOP.STAGING_MARTS.obt_sales
         as
        (

WITH ventes AS (
    SELECT * FROM BOOKSHOP.STAGING_WAREHOUSE.fact_ventes
), factures AS (
    SELECT * FROM BOOKSHOP.STAGING_WAREHOUSE.fact_factures
), categories AS (
    SELECT * FROM BOOKSHOP.STAGING_WAREHOUSE.dim_category
), books AS (
    SELECT * FROM BOOKSHOP.STAGING_WAREHOUSE.dim_books
), customers AS (
    SELECT * FROM BOOKSHOP.STAGING_WAREHOUSE.dim_customers
)

SELECT
    v.id,
    v.annees,
    v.mois,
    v.jour,
    v.pu,
    v.qte,
    f.facture_id,
    f.reference AS facture_code,
    f.quantite_totale AS qte_totale,
    f.montant_ht AS total_amount,
    f.montant_ttc AS total_paid,
    cat.intitule AS category,
    b.code AS book_code,
    b.intitule AS book_title,
    b.isbn_10,
    b.isbn_13,
    cu.code AS customer_code,
    cu.nom AS customer_name
FROM ventes v
         JOIN factures f ON v.facture_id = f.facture_id
         JOIN books b ON v.livre_id = b.code
         JOIN categories cat ON b.code_category = cat.code
         JOIN customers cu ON f.client_id = cu.code
        );
